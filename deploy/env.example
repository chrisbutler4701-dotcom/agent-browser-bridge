# Network
FBB_LISTEN_HOST=172.18.0.1
FBB_LISTEN_PORT=8767
PUBLIC_BASE_URL=https://bridge.example.com

# OAuth. Set a long, unique passphrase before starting the service.
FBB_LOGIN_PASSPHRASE=
# Owner administration uses a separate passphrase from OAuth web-app sign-in.
FBB_OWNER_PASSPHRASE=
FBB_OAUTH_STATE=/var/lib/field-browser-bridge/oauth.json
# Empty means browser.read only.
FBB_OAUTH_CAPABILITIES=
# Comma-separated direct proxy addresses allowed to supply X-Forwarded-For.
FBB_TRUSTED_PROXIES=
FBB_OAUTH_MAX_CLIENTS=50

# Browser pairing credential. This never authenticates MCP.
WORK_EDGE_DEV_TOKEN=
# The only MCP owner credential. Generate a unique value and never commit the
# populated environment file.
WORK_EDGE_MCP_TOKEN=
WORK_EDGE_MCP_ID=owner-bootstrap
WORK_EDGE_AUTO_PROVISION_CAPABILITIES=

# Broker policy and durable state
WORK_EDGE_POLICY=/opt/field-browser-bridge/config/policy.example.json
WORK_EDGE_TOKEN_STORE=/var/lib/field-browser-bridge/browser-tokens.json
WORK_EDGE_AGENT_TOKEN_STORE=/var/lib/field-browser-bridge/agent-tokens.json
FBB_APPROVER_STORE=/var/lib/field-browser-bridge/approvers.json
WORK_EDGE_COMMAND_STATE=/var/lib/field-browser-bridge/command-state.json
WORK_EDGE_RECEIPT_STORE=/var/lib/field-browser-bridge/verified-action-receipts.json
WORK_EDGE_TRANSACTION_STORE=/var/lib/field-browser-bridge/verified-action-transactions.json
WORK_EDGE_TRANSACTION_KEY=/var/lib/field-browser-bridge/verified-action-transactions.key
WORK_EDGE_HANDOFF_AUTH_SECRET=
