{
  "name": "field-browser-bridge",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Secure MCP bridge for controlling a paired Chrome browser",
  "scripts": {
    "test": "node scripts/validate.js && node --test",
    "agent-token": "node scripts/agent-token.js",
